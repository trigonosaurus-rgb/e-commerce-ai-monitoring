# Copy to `.env` and fill in. Everything except the two API keys is optional.

# --- AI & search (required for the discovery agent and AI price reading) ---
OPENAI_API_KEY=
TAVILY_API_KEY=
# MODEL_FAST=gpt-6-luna          # extraction, classification, search planning
# MODEL_SMART=gpt-6.1-sol        # alert summaries
# REASONING_EFFORT_FAST=low      # empty = don't send the parameter (for models without reasoning)
# REASONING_EFFORT_SMART=medium

# --- Monitoring ---
# CHECK_INTERVAL_HOURS=12
# ALERT_MIN_CHANGE_PCT=1         # smaller moves are recorded but don't alert
# REVIEW_JUMP_PCT=60             # bigger jumps wait for a human review
# MAX_PRODUCTS_PER_USER=25
# MAX_OFFERS_PER_PRODUCT=6

# --- Public site ---
# PUBLIC_URL=http://localhost:3000   # used for links inside alerts
# COOKIE_SECURE=false                # true when served over HTTPS
CONTACT_EMAIL=
CONTACT_TELEGRAM=                    # username without @, shown in "Request access"

# --- Telegram alerts (create a bot with @BotFather) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=               # without @
OWNER_TELEGRAM_CHAT_ID=              # your chat id: access requests are forwarded here

# --- Email alerts (any SMTP: Gmail app password, Resend, Mailgun...) ---
SMTP_HOST=
# SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# SMTP_SSL=false                     # true for port 465

# DATABASE_URL=sqlite:///data/rivalscope.db
# SCHEDULER_ENABLED=true
